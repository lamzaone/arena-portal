# This bot runs as its own persistent Node service. Never expose these in NEXT_PUBLIC_*.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_STAFF_CHANNEL_ID=
# Same random secret (at least 32 characters) as the portal server.
DISCORD_BRIDGE_SECRET=
PORTAL_URL=https://arena.example
# Optional additional/fallback admin role IDs, comma-separated.
# Existing roles must be mentionable or bot needs Mention Everyone in staff channel.
DISCORD_ADMIN_ROLE_IDS=
