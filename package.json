{
  "name": "arena-portal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:hosting": "node scripts/build-hosting.mjs",
    "build:release": "node scripts/build-hosting.mjs --standalone",
    "build:cloudflare": "node scripts/prepare-opennext-windows.mjs && opennextjs-cloudflare build",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "release:cloudflare": "npm run build:cloudflare && npm run deploy:cloudflare",
    "start": "next start",
    "start:hosting": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "migrate:arena-groups": "node scripts/migrate-arena-group-authority.mjs",
    "migrate:vip-scope": "node scripts/migrate-vip-scope.mjs",
    "test": "npm run test:health && npm run test:seo && npm run test:vip && npm run test:scope && npm run test:vip-scope-migration && npm run test:database && npm run test:navigation && npm run test:loadout && npm run test:inventory-lock && npm run test:inventory-selection && npm run test:crates && npm run test:sellback && npm run test:chat-colors && npm run test:steam && npm run test:server-status && npm run test:player-identities && npm run test:themes",
    "test:health": "node --experimental-strip-types --test app/api/health/route.test.ts lib/form-action-response.test.ts",
    "test:player-identities": "node --experimental-strip-types --test lib/player-identities.test.ts lib/player-search.test.ts",
    "test:themes": "node --experimental-strip-types --test lib/themes/registry.test.ts && node --experimental-transform-types --test lib/data/profile-theme-entitlements.test.ts",
    "test:chat-colors": "node --experimental-strip-types --test lib/chat-colors.test.ts",
    "test:seo": "node --experimental-strip-types --test lib/seo/site.test.ts",
    "test:vip": "node --experimental-strip-types --test lib/economy/vip-membership-conversion.test.ts lib/economy/vip-activation-state.test.ts",
    "test:navigation": "node --experimental-strip-types --test components/primary-navigation-routes.test.ts",
    "test:loadout": "node --experimental-strip-types --test lib/economy/weapon-categories.test.ts lib/economy/loadout-selection.test.ts",
    "test:inventory-lock": "node --experimental-strip-types --test lib/economy/inventory-sale-lock.test.ts",
    "test:inventory-selection": "node --experimental-strip-types --test lib/economy/inventory-selection.test.ts",
    "test:crates": "node --experimental-strip-types --test lib/economy/crate-presentation.test.ts",
    "test:sellback": "node --experimental-strip-types --test lib/economy/sellback.test.ts",
    "test:scope": "node --test lib/data/arena-scope-resolution.test.mjs",
    "test:vip-scope-migration": "node --test scripts/vip-scope-consolidation-policy.test.mjs scripts/vip-scope-consolidation-cli.test.mjs",
    "test:steam": "node --experimental-strip-types --test lib/steam/*.test.ts",
    "test:database": "node --experimental-strip-types --test lib/data/mysql-utc-session.test.ts && npm run test:worker-database",
    "test:worker-database": "node --test cloudflare/request-database-scope.test.mjs scripts/prepare-opennext-windows.test.mjs",
    "test:server-status": "node --experimental-strip-types --test lib/server-link/*.test.ts"
  },
  "dependencies": {
    "lucide-react": "^1.34.0",
    "mysql2": "^3.24.2",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "typescript": "^5.9.3",
    "wrangler": "4.129.0"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.4"
  }
}
