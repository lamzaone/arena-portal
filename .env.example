# Public URL of this portal. It must exactly match the domain configured for Steam OpenID.
SITE_URL=https://arena.example.com

# Use a long random value. Required to protect sensitive staff-action CSRF tokens.
SESSION_SECRET=replace-with-a-long-random-secret

# Shown on the landing page and used by the Connect buttons.
NEXT_PUBLIC_SERVER_NAME=ARENA.TAPPED.RO
NEXT_PUBLIC_SERVER_CONNECT_URL=steam://connect/arena.tapped.ro

# Dedicated secret shared only with TAPPED.ServerLink (at least 32 random characters).
# Store in the host environment or private .env.production; never expose as NEXT_PUBLIC_*.
# Live status requires db/027_server_link.sql and the plugin's HTTPS heartbeats.
SERVER_LINK_SECRET=

# MySQL connection to the existing Swiftly game database. A SELECT-only account
# is sufficient for display-only deployments. Database-authoritative Staff >
# Groups management needs a dedicated account with narrowly scoped INSERT and
# UPDATE on groups, admins, and vip_group_definitions, plus INSERT, UPDATE, and
# DELETE on vip_users. Do not grant DDL or writes to unrelated game tables.
GAME_DATABASE_URL=mysql://arena-portal-game:password@127.0.0.1:3306/cs2
# VIPCore server scope used by rosters, connected groups, and runtime-verified
# perk offers. Together with GAME_SERVER_GUID below, this identifies one
# physical server and one Arena scope. Use 0 only when VIPCore has
# ShareServerId enabled; zero always maps to the global scope.
GAME_VIP_SERVER_ID=1

# Optional Steam Web API key. Enables real Steam profile pictures on /ranking.
STEAM_WEB_API_KEY=

# Enables the website to enqueue validated moderation jobs for the Swiftly
# bridge. The website never writes bans or WeaponSkins tables directly.
PORTAL_BRIDGE_ENABLED=false
# Current ARENA.TAPPED.RO Admins.Core server GUID. Override only if it changes.
# Do not substitute vip_servers.GUID; VIPCore generates an unrelated GUID.
GAME_SERVER_GUID=05eda3ad-2921-4083-adfb-2e23596c8caa

# Separate MySQL database used only by the portal for accounts, links, tickets, appeals, and audit events.
PORTAL_DATABASE_URL=mysql://portal-user:password@127.0.0.1:3306/arena_portal

# Shared mysql2 limit per database and Node process. Keeping this low
# avoids multiplying connections as additional instances start.
DATABASE_CONNECTION_LIMIT=5

# Optional identity-catalogue overrides. Admins.Core and VIPCore JSON files are
# one-time seed inputs; their database tables are authoritative after bootstrap.
# These are needed only when the portal cannot discover the adjacent
# addons/swiftlys2/configs and source folders.
# ARENA_SWIFTLY_CONFIG_ROOT=D:/ARENA/addons/swiftlys2/configs
# ADMINS_GROUPS_CONFIG_PATH=D:/ARENA/addons/swiftlys2/configs/plugins/Admins.Core/groups.json
# VIP_GROUPS_CONFIG_PATH=D:/ARENA/addons/swiftlys2/configs/plugins/VIPCore/vip_groups.jsonc
# IDENTITY_PERMISSION_SOURCE_PATHS=D:/ARENA/Admins-source;D:/ARENA/VIPCore-source

# Public CS2 price refresh. The portal Node server refreshes every enabled
# exact market-hash item on this interval (60 minutes by default). Set false to
# disable its in-process worker. The secret protects the optional cron route
# at /api/cron/economy-prices for serverless/externally scheduled deployments.
ECONOMY_PRICE_REFRESH_ENABLED=true
ECONOMY_PRICE_REFRESH_INTERVAL_MINUTES=60
ECONOMY_PRICE_REFRESH_SECRET=replace-with-a-long-random-secret

# Optional CSFloat API key. Configure this on the deployment host to let a missing-price
# sale query live listings by the item's float and paint seed.
CSFLOAT_API_KEY=

# Exact weapon thumbnails: persistent writable cache on a Node host.
# WEAPON_THUMBNAIL_CACHE_DIR=/home/account/arena-portal/cache/weapon-thumbnails
# WEAPON_THUMBNAIL_ASSET_CACHE_DIR=/home/account/arena-portal/cache/weapon-thumbnail-assets
# WEAPON_THUMBNAIL_BROWSER_PATH=/usr/bin/chromium
# Windows uses full Chromium and the GPU by default. Set false for software rendering.
# Linux GPU rendering requires full Chromium and working GPU drivers; opt in with true.
# WEAPON_THUMBNAIL_GPU=false
