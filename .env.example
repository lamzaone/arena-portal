# Public URL of this portal. It must exactly match the domain configured for Steam OpenID.
SITE_URL=https://arena.example.com

# Use a long random value. Required to protect sensitive staff-action CSRF tokens.
SESSION_SECRET=replace-with-a-long-random-secret

# Shown on the landing page and used by the Connect buttons.
NEXT_PUBLIC_SERVER_NAME=ARENA.TAPPED.RO
NEXT_PUBLIC_SERVER_CONNECT_URL=steam://connect/arena.tapped.ro

# Optional: the source of live server status. It should return
# { status: "online" | "offline", players: number, maxPlayers: number, map: string }.
SERVER_STATUS_ENDPOINT=

# Read-only MySQL connection to the existing Swiftly game database.
# Used for lvl_base, admins, bans, sanctions, vip_users, and WeaponSkins tables.
GAME_DATABASE_URL=mysql://readonly-user:password@127.0.0.1:3306/cs2
# VIPCore server scope used by rosters, connected groups, and runtime-verified
# perk offers. Use 0 only when VIPCore has ShareServerId enabled.
GAME_VIP_SERVER_ID=1

# Optional Steam Web API key. Enables real Steam profile pictures on /ranking.
STEAM_WEB_API_KEY=

# Enables the website to enqueue validated moderation jobs for the Swiftly
# bridge. The website never writes bans or WeaponSkins tables directly.
PORTAL_BRIDGE_ENABLED=false
# Current ARENA.TAPPED.RO Admins.Core server GUID. Override only if it changes.
GAME_SERVER_GUID=05eda3ad-2921-4083-adfb-2e23596c8caa

# Separate MySQL database used only by the portal for accounts, links, tickets, appeals, and audit events.
PORTAL_DATABASE_URL=mysql://portal-user:password@127.0.0.1:3306/arena_portal

# Shared mysql2 limit per database and warm Vercel instance. Keeping this low
# avoids multiplying connections as serverless instances scale out.
DATABASE_CONNECTION_LIMIT=5

# Optional identity-catalogue overrides. They are only needed when the portal
# cannot discover the adjacent addons/swiftlys2/configs and source folders.
# ARENA_SWIFTLY_CONFIG_ROOT=D:/ARENA/addons/swiftlys2/configs
# ADMINS_GROUPS_CONFIG_PATH=D:/ARENA/addons/swiftlys2/configs/plugins/Admins.Core/groups.json
# VIP_GROUPS_CONFIG_PATH=D:/ARENA/addons/swiftlys2/configs/plugins/VIPCore/vip_groups.jsonc
# IDENTITY_PERMISSION_SOURCE_PATHS=D:/ARENA/Admins-source;D:/ARENA/VIPCore-source

# Public CS2 price refresh. The portal Node server refreshes every enabled
# exact market-hash item on this interval (60 minutes by default). Set false to
# disable its in-process worker. The secret protects the optional cron route
# at /api/cron/economy-prices for serverless/externally scheduled deployments.
ECONOMY_PRICE_REFRESH_ENABLED=true
ECONOMY_PRICE_REFRESH_INTERVAL_MINUTES=60
ECONOMY_PRICE_REFRESH_SECRET=replace-with-a-long-random-secret

# Optional CSFloat API key. Configure this in Vercel to let a missing-price
# sale query live listings by the item's float and paint seed.
CSFLOAT_API_KEY=
