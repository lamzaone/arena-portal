# Copy to .env.production inside the private application directory on FreakHosting.
# Fill in existing production secrets and database URLs before starting the app.
# Do not upload a development .env.local: Next.js gives it higher priority.
SITE_URL=https://tapped.ro
NEXT_PUBLIC_SERVER_NAME=ARENA.TAPPED.RO
NEXT_PUBLIC_SERVER_CONNECT_URL=steam://connect/arena.tapped.ro

# Preserve these values from the current deployment so integrations still match.
SESSION_SECRET=
SERVER_LINK_SECRET=
GAME_DATABASE_URL=
PORTAL_DATABASE_URL=
STEAM_WEB_API_KEY=
GAME_SERVER_GUID=05eda3ad-2921-4083-adfb-2e23596c8caa
GAME_VIP_SERVER_ID=1
DATABASE_CONNECTION_LIMIT=5

# Set true only if TAPPED.PortalBridge is installed and configured for this DB.
PORTAL_BRIDGE_ENABLED=false

# Automatic mode keeps the Node process and this hourly worker running.
ECONOMY_PRICE_REFRESH_ENABLED=true
ECONOMY_PRICE_REFRESH_INTERVAL_MINUTES=60
ECONOMY_PRICE_REFRESH_SECRET=
CSFLOAT_API_KEY=

# PORT is a startup setting, not a Next.js .env setting. The default is 3000.
# For another port, set PORT in the panel startup command and match its proxy port.
